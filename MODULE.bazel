"""
# This is a Bazel module file that defines dependencies for the Hermes-Beta project.
"""

module(name = "hermes_beta", version = "0.0.1")

bazel_dep(name = "apple_support", version = "1.21.1", repo_name = "build_bazel_apple_support")
bazel_dep(name = "rules_cc", version = "0.1.2")
bazel_dep(name = "rules_apple", version = "3.20.1", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "rules_swift", version = "2.8.1", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "platforms", version = "1.0.0")

metal_cpp_headers = use_extension("//third_party/metal_cpp:metal_cpp.bzl", "metal_cpp_headers")
use_repo(metal_cpp_headers, "metal_cpp_headers")

# Hedron's Compile Commands Extractor for Bazel
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "4f28899228fb3ad0126897876f147ca15026151e",
)

bazel_dep(name = "googletest", version = "1.17.0")
